<?xml version="1.0" encoding="UTF-8"?>
<project name="HelloWorld" default="compile" basedir=".">

    <property name="source.dir" value="${basedir}/src" />
    <property name="scala-source.dir" value="${source.dir}/main/scala" />
    <property name="target.dir" value="${basedir}/target" />
    <property name="target-docs.dir" value="${target.dir}/docs" />
    <property name="build.dir" value="${target.dir}/classes" />
    <property name="cfr-source.dir" value="${target.dir}/cfr-sources" />
    <property name="main.class" value="myexamples.${ant.project.name}" />

    <!-- task 'init' and macro 'dotc' are defined in parent build.xml -->
    <import file="../build.xml" />

    <target name="compile" depends="init">
        <mkdir dir="${build.dir}" />
        <dotc srcdir="${scala-source.dir}"
              destdir="${build.dir}"
              classpathref="build.classpath" />
    </target>

    <target name="decompile" depends="compile">
        <mkdir dir="${cfr-source.dir}" />
        <cfr srcdir="${build.dir}"
             destdir="${cfr-source.dir}"
             classpathref="build.classpath" />
    </target>

    <target name="doc" depends="compile">
        <mkdir dir="${target-docs.dir}" />
        <dotd srcdir="${build.dir}"
              destdir="${target-docs.dir}"
              classpathref="build.classpath" />
    </target>

    <target name="lint">
        <exec executable="${scalafmt.cmd}">
            <arg value="--test" />
            <arg value="--config" />
            <arg path="../.scalafmt.conf" />
        </exec>
    </target>

    <target name="run" depends="compile">
        <java classname="${main.class}">
            <!-- <arg value="1" /> -->
            <classpath>
                <path refid="scala3.classpath" />
                <path refid="build.classpath" />
            </classpath>
        </java>
    </target>

    <target name="jar" depends="compile">
        <jar destfile="${target.dir}/${ant.project.name}.jar"
             basedir="${build.dir}">
             <manifest>
                 <attribute name="Main-Class" value="${main.class}"/>
             </manifest>
        </jar>
    </target>

    <target name="spotbugs" depends="jar">
        <spotbugs home="${env.SPOTBUGS_HOME}"
                  sourcepath="${source.dir}"
                  outputFile="${target.dir}/${ant.project.name}-sb.xml">
            <auxClasspath>
                <fileset dir="${env.SCALA3_HOME}/lib" includes="scala-library*.jar" />
                <fileset dir="${env.SCALA3_HOME}/lib" includes="scala3-library*.jar" />
            </auxClasspath>
            <class location="${target.dir}/${ant.project.name}.jar" />
        </spotbugs>
    </target>

    <target name="clean">
        <delete dir="${target.dir}"/>
    </target>

</project>
